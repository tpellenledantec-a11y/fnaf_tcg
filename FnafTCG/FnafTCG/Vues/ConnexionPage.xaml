<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:FnafTCG.VuesModeles"
    x:Class="FnafTCG.Vues.ConnexionPage"
    x:DataType="vm:ConnexionVueModele"
    Title="Connexion"
    BackgroundColor="#050507">

    <ScrollView>

        <VerticalStackLayout
            Padding="24,30,24,35"
            Spacing="0">

            <!-- ================================================= -->
            <!-- LOGO FAZMARKET                                   -->
            <!-- ================================================= -->

            <VerticalStackLayout
                HorizontalOptions="Center"
                Margin="0,20,0,68"
                Spacing="12">

                <Border
                    WidthRequest="106"
                    HeightRequest="106"
                    BackgroundColor="Transparent"
                    Stroke="#FFA500"
                    StrokeThickness="2"
                    StrokeShape="RoundRectangle 53"
                    HorizontalOptions="Center">

                    <Grid>

                        <!-- Halo autour du logo -->
                        <Border
                            Margin="-7"
                            BackgroundColor="Transparent"
                            Stroke="#FFA500"
                            StrokeThickness="1"
                            Opacity="0.15"
                            StrokeShape="RoundRectangle 60" />

                        <!-- Visage -->
                        <VerticalStackLayout
                            HorizontalOptions="Center"
                            VerticalOptions="Center"
                            Spacing="2">

                            <HorizontalStackLayout
                                HorizontalOptions="Center"
                                Spacing="14">

                                <Ellipse
                                    WidthRequest="5"
                                    HeightRequest="5"
                                    Fill="#FFA500" />

                                <Ellipse
                                    WidthRequest="5"
                                    HeightRequest="5"
                                    Fill="#FFA500" />

                            </HorizontalStackLayout>

                            <Label
                                Text="⌢"
                                FontSize="34"
                                FontAttributes="Bold"
                                TextColor="#FFA500"
                                HorizontalTextAlignment="Center"
                                VerticalTextAlignment="Center" />

                        </VerticalStackLayout>

                    </Grid>

                </Border>

                <Label
                    Text="FAZMARKET"
                    FontSize="40"
                    FontAttributes="Bold"
                    TextColor="#F5F5F5"
                    HorizontalTextAlignment="Center" />

                <Label
                    Text="SYSTÈME DE TRANSACTION RÉSEAU"
                    FontSize="14"
                    CharacterSpacing="1"
                    TextColor="#9295A0"
                    HorizontalTextAlignment="Center" />

            </VerticalStackLayout>


            <!-- ================================================= -->
            <!-- TITRE                                             -->
            <!-- ================================================= -->

            <VerticalStackLayout
                Spacing="8">

                <Label
                    Text="Connexion requise"
                    FontSize="30"
                    FontAttributes="Bold"
                    TextColor="#F5F5F5" />

                <Label
                    Text="Entrez vos identifiants autorisés par Fazbear Entertainment."
                    FontSize="18"
                    LineHeight="1.15"
                    TextColor="#9699A5" />

            </VerticalStackLayout>


            <!-- ================================================= -->
            <!-- IDENTIFIANT                                      -->
            <!-- ================================================= -->

            <VerticalStackLayout
                Spacing="8"
                Margin="0,28,0,0">

                <Label
                    Text="IDENTIFIANT EMAIL"
                    FontSize="14"
                    CharacterSpacing="1"
                    TextColor="#FFA500" />

                <Border
                    HeightRequest="56"
                    BackgroundColor="#121216"
                    Stroke="#292B33"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 10">

                    <Grid
                        ColumnDefinitions="45,*"
                        Padding="8,0">

                        <Label
                            Grid.Column="0"
                            Text="✉"
                            FontSize="25"
                            TextColor="#9A9DA8"
                            HorizontalTextAlignment="Center"
                            VerticalTextAlignment="Center" />

                        <Entry
                            Grid.Column="1"
                            Text="{Binding Identifiant}"
                            Placeholder="Adresse email"
                            PlaceholderColor="#666873"
                            TextColor="#F5F5F5"
                            BackgroundColor="Transparent"
                            FontSize="17"
                            Keyboard="Email"
                            ClearButtonVisibility="WhileEditing"
                            VerticalOptions="Center" />

                    </Grid>

                </Border>

            </VerticalStackLayout>


            <!-- ================================================= -->
            <!-- MOT DE PASSE                                    -->
            <!-- ================================================= -->

            <VerticalStackLayout
                Spacing="8"
                Margin="0,22,0,0">

                <Label
                    Text="MOT DE PASSE CRYPTÉ"
                    FontSize="14"
                    CharacterSpacing="1"
                    TextColor="#FFA500" />

                <Border
                    HeightRequest="56"
                    BackgroundColor="#121216"
                    Stroke="#292B33"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 10">

                    <Grid
                        ColumnDefinitions="45,*"
                        Padding="8,0">

                        <Label
                            Grid.Column="0"
                            Text="🔒"
                            FontSize="20"
                            HorizontalTextAlignment="Center"
                            VerticalTextAlignment="Center" />

                        <Entry
                            Grid.Column="1"
                            Text="{Binding MotDePasse}"
                            Placeholder="Mot de passe"
                            PlaceholderColor="#666873"
                            TextColor="#F5F5F5"
                            BackgroundColor="Transparent"
                            FontSize="17"
                            IsPassword="True"
                            VerticalOptions="Center" />

                    </Grid>

                </Border>

            </VerticalStackLayout>


            <!-- ================================================= -->
            <!-- MESSAGE API / VALIDATION                         -->
            <!-- ================================================= -->

            <Label
                Text="{Binding Message}"
                TextColor="#FF6B6B"
                FontSize="14"
                Margin="0,12,0,0" />


            <!-- ================================================= -->
            <!-- BOUTON CONNEXION                                 -->
            <!-- ================================================= -->

            <Button
                Text="Se connecter au réseau"
                Command="{Binding SeConnecterCommand}"
                IsEnabled="{Binding EstDisponible}"
                HeightRequest="64"
                Margin="0,105,0,0"
                BackgroundColor="#FFA500"
                TextColor="#050507"
                FontSize="20"
                FontAttributes="Bold"
                CornerRadius="10" />


            <!-- ================================================= -->
            <!-- CHARGEMENT                                      -->
            <!-- ================================================= -->

            <ActivityIndicator
                IsRunning="{Binding EstOccupe}"
                IsVisible="{Binding EstOccupe}"
                Color="#FFA500"
                WidthRequest="35"
                HeightRequest="35"
                HorizontalOptions="Center"
                Margin="0,18,0,0" />

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>